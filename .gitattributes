# Normalise line endings in the repository, check out as LF everywhere.
* text=auto eol=lf

# Source and config are always text.
*.py        text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.txt       text eol=lf
.editorconfig text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Shell scripts need LF to be executable on Unix.
*.sh        text eol=lf

# Wordlists are data, not text: no EOL conversion, no diff munging,
# no merge attempts. A normalised wordlist is a corrupted wordlist.
subpy/data/*.txt  -text -diff -merge

# Binary assets.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.woff      binary
*.woff2     binary
